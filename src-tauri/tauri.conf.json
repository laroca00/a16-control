{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GiENEMY",
  "mainBinaryName": "GiENEMY",
  "version": "0.1.0",
  "identifier": "com.laroca00.gienemy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GiENEMY",
        "width": 1040,
        "height": 680,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "panel",
        "title": "GiENEMY",
        "width": 360,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
