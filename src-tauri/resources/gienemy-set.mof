// GiENEMY: declares the BIOS's ACPI-WMI setter block so Windows exposes it
// as root\WMI:GB_WMIACPI_Set. Compiled when the class is missing one of the
// methods GiENEMY uses; it declares every method Gigabyte's own definition
// has, so replacing that definition loses nothing.
#pragma namespace("\\\\.\\root\\wmi")

[WMI, Dynamic, Provider("WmiProv"), Locale("MS\\0x409"),
 Description("Gigabyte ACPI-WMI setters (GiENEMY)"),
 guid("{ABBC0F75-8EA1-11d1-00A0-C90629100000}")]
class GB_WMIACPI_Set
{
    [key, read] string InstanceName;
    [read] boolean Active;

    [WmiMethodId(71), Implemented, Description("Fan 2 fixed duty")]
    void SetGPUFanDuty([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(81), Implemented, Description("NVIDIA Dynamic Boost bias")]
    void SetNvPowerConfig([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(102), Implemented, Description("Fan step index")]
    void SetCurrentFanStep([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(103), Implemented, Description("Step fan mode on/off")]
    void SetStepFanStatus([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(106), Implemented, Description("Fixed fan lock on/off")]
    void SetFixedFanStatus([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(107), Implemented, Description("Fan 1 fixed duty")]
    void SetFixedFanSpeed([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(113), Implemented, Description("Automatic fan governor on/off")]
    void SetAutoFanStatus([in, WmiDataId(1)] uint8 Data);

    // IDs from Gigabyte's AERO 16 YE5 setter MOF; the firmware shares them
    // across models but does not have to implement every one.
    [WmiMethodId(133), Implemented, Description("Whisper (quiet) fan mode on/off")]
    void SetWhisperMode([in, WmiDataId(1)] uint8 Data);

    // Read from this BIOS's own WMBD dispatcher (DSDT, 2026-11-28); each
    // writes one EC or CMOS field. See docs/firmware-methods.md.
    [WmiMethodId(100), Implemented, Description("Charge policy: 0 standard, 1 stop at the charge limit")]
    void SetChargePolicy([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(101), Implemented, Description("Charge limit, percent")]
    void SetChargeStop([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(135), Implemented, Description("Power LED: 1 on, 0 off")]
    void SetPwrLightDisplay([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(136), Implemented, Description("Battery LED: 1 on, 0 off")]
    void SetBatteryLightDisplay([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(163), Implemented, Description("Boot logo animation (CMOS)")]
    void SetPostAnimate([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(201), Implemented, Description("Fn lock")]
    void SetFnKeyLockStatus([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(202), Implemented, Description("Touchpad switch")]
    void SetTouchPadStatus([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(203), Implemented, Description("Windows key lock")]
    void SetWinKeyLockStatus([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(230), Implemented, Description("GPU mode for the next boot (CMOS)")]
    void SetPEG2orSG2([in, WmiDataId(1)] uint8 Data);

    [WmiMethodId(241), Implemented, Description("APU sustained power limit, mW")]
    void SetApuParameter3([in, WmiDataId(1)] uint32 Data);

    [WmiMethodId(242), Implemented, Description("APU slow power limit, mW")]
    void SetApuParameter2([in, WmiDataId(1)] uint32 Data);

    [WmiMethodId(243), Implemented, Description("APU fast power limit, mW")]
    void SetApuParameter1([in, WmiDataId(1)] uint32 Data);
};
